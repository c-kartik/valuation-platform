{
  "hosting": {
    "site": "kartikchaturvedi-website",
    "public": "frontend/dist",
    "ignore": ["**/.*", "**/node_modules/**", "**/*.map", "**/*.json"],
    "predeploy": ["python3 scripts/check_firebase_preview.py --for-deploy"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key": "Cache-Control", "value": "no-store"},
          {"key": "X-Content-Type-Options", "value": "nosniff"},
          {"key": "Referrer-Policy", "value": "no-referrer"},
          {"key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"},
          {"key": "X-Robots-Tag", "value": "noindex, nofollow"}
        ]
      },
      {
        "source": "/assets/**",
        "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
      },
      {
        "source": "/api{,/**}",
        "headers": [{"key": "Cache-Control", "value": "no-store"}]
      }
    ],
    "rewrites": [
      {
        "source": "/api{,/**}",
        "run": {"serviceId": "valuation-api-preview", "region": "us-central1", "pinTag": true}
      },
      {"source": "**", "destination": "/index.html"}
    ]
  }
}
