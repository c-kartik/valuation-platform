<?xml version="1.0" encoding="UTF-8"?>
<xbrli:xbrl
    xmlns:xbrli="http://www.xbrl.org/2003/instance"
    xmlns:xbrldi="http://xbrl.org/2006/xbrldi"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:iso4217="http://www.xbrl.org/2003/iso4217"
    xmlns:us-gaap="http://fasb.org/us-gaap/2025"
    xmlns:dei="http://xbrl.sec.gov/dei/2025"
    xmlns:ex="http://example.com/2025">
  <xbrli:context id="current">
    <xbrli:entity><xbrli:identifier scheme="http://www.sec.gov/CIK">0000000001</xbrli:identifier></xbrli:entity>
    <xbrli:period><xbrli:startDate>2025-01-01</xbrli:startDate><xbrli:endDate>2025-12-31</xbrli:endDate></xbrli:period>
  </xbrli:context>
  <xbrli:context id="comparative">
    <xbrli:entity><xbrli:identifier scheme="http://www.sec.gov/CIK">0000000001</xbrli:identifier></xbrli:entity>
    <xbrli:period><xbrli:startDate>2024-01-01</xbrli:startDate><xbrli:endDate>2024-12-31</xbrli:endDate></xbrli:period>
  </xbrli:context>
  <xbrli:context id="instant">
    <xbrli:entity><xbrli:identifier scheme="http://www.sec.gov/CIK">0000000001</xbrli:identifier></xbrli:entity>
    <xbrli:period><xbrli:instant>2025-12-31</xbrli:instant></xbrli:period>
  </xbrli:context>
  <xbrli:context id="explicit">
    <xbrli:entity>
      <xbrli:identifier scheme="http://www.sec.gov/CIK">0000000001</xbrli:identifier>
      <xbrli:segment><xbrldi:explicitMember dimension="us-gaap:StatementBusinessSegmentsAxis">ex:CloudMember</xbrldi:explicitMember></xbrli:segment>
    </xbrli:entity>
    <xbrli:period><xbrli:startDate>2025-01-01</xbrli:startDate><xbrli:endDate>2025-12-31</xbrli:endDate></xbrli:period>
  </xbrli:context>
  <xbrli:context id="typed">
    <xbrli:entity>
      <xbrli:identifier scheme="http://www.sec.gov/CIK">0000000001</xbrli:identifier>
      <xbrli:segment><xbrldi:typedMember dimension="ex:CustomerAxis"><ex:CustomerDomain>Customer A</ex:CustomerDomain></xbrldi:typedMember></xbrli:segment>
    </xbrli:entity>
    <xbrli:period><xbrli:startDate>2025-01-01</xbrli:startDate><xbrli:endDate>2025-12-31</xbrli:endDate></xbrli:period>
  </xbrli:context>
  <xbrli:unit id="usd"><xbrli:measure>iso4217:USD</xbrli:measure></xbrli:unit>
  <xbrli:unit id="usdPerShare">
    <xbrli:divide>
      <xbrli:unitNumerator><xbrli:measure>iso4217:USD</xbrli:measure></xbrli:unitNumerator>
      <xbrli:unitDenominator><xbrli:measure>xbrli:shares</xbrli:measure></xbrli:unitDenominator>
    </xbrli:divide>
  </xbrli:unit>
  <us-gaap:Revenues contextRef="current" unitRef="usd" decimals="-6">1000000000</us-gaap:Revenues>
  <ex:DepreciationAmortizationAndOther contextRef="current" unitRef="usd" decimals="-6">250000000</ex:DepreciationAmortizationAndOther>
  <us-gaap:Revenues contextRef="comparative" unitRef="usd" decimals="-6">900000000</us-gaap:Revenues>
  <us-gaap:CashAndCashEquivalentsAtCarryingValue contextRef="instant" unitRef="usd" decimals="INF">500000000</us-gaap:CashAndCashEquivalentsAtCarryingValue>
  <us-gaap:Revenues contextRef="explicit" unitRef="usd" decimals="-6">600000000</us-gaap:Revenues>
  <ex:ContractValue contextRef="typed" unitRef="usd" decimals="-6">10000000</ex:ContractValue>
  <us-gaap:EarningsPerShareBasic contextRef="current" unitRef="usdPerShare" decimals="2">3.25</us-gaap:EarningsPerShareBasic>
  <us-gaap:OperatingIncomeLoss contextRef="current" unitRef="usd" decimals="-6" xsi:nil="true"/>
  <dei:EntityRegistrantName contextRef="instant">Example Company</dei:EntityRegistrantName>
</xbrli:xbrl>
