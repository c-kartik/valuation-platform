{
  "name": "valuation-local-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "dev:python": "VALUATION_ENGINE=python vite --port 5197",
    "build": "tsc --noEmit && vite build",
    "build:python": "tsc --noEmit && VALUATION_ENGINE=python vite build --outDir=dist-python",
    "build:browser": "tsc --noEmit && VALUATION_ENGINE=browser vite build --base=/valuation/ --outDir=dist-browser",
    "dev:browser": "VALUATION_ENGINE=browser vite --port 5196",
    "test:browser": "VALUATION_ENGINE=browser vitest run src/browser-engine",
    "test": "VALUATION_ENGINE=python vitest run",
    "dev:prototype": "vite --config vite.prototype.config.ts",
    "build:prototype": "tsc --noEmit && vite build --config vite.prototype.config.ts"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "26.1.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
